{
  "name": "ben-js-router-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host",
    "preview": "vite preview",
    "check": "run-p check:*",
    "check:types": "tsc -b",
    "check:oxlint": "oxlint",
    "check:stylelint": "stylelint '**/*.{ts,css}' --ignore-path .gitignore",
    "check:oxfmt": "oxfmt --check",
    "fix": "run-s fix:lint fix:oxfmt",
    "fix:lint": "run-p fix:oxlint fix:stylelint",
    "fix:oxlint": "oxlint --fix",
    "fix:stylelint": "stylelint '**/*.{ts,css}' --ignore-path .gitignore --fix",
    "fix:oxfmt": "oxfmt"
  },
  "dependencies": {
    "@ben-js/router": "workspace:*",
    "ben-js": "workspace:*",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@gardinbe/config": "github:gardinbe/config",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.3.1",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "stylelint": "^17.11.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">24.3.0"
  },
  "packageManager": "pnpm@11.2.1"
}
